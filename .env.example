APP_NAME=Capell
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Leave APP_URL empty on Laravel Cloud. The Cloud-assigned domain is not known
# until after the app is created, and Capell must NOT guess it. Set this (and
# pass --url to capell:install) to the real domain once you know it.
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default. Laravel Cloud injects DB_* for the provisioned database.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Capell -----------------------------------------------------------------
# Composer registry auth for fetching the private capell-app/* packages during
# `composer install`. Set COMPOSER_AUTH in the Laravel Cloud environment (NOT
# committed). Example for an HTTP-basic registry:
#   COMPOSER_AUTH={"http-basic":{"composer.capell.app":{"username":"token","password":"<TOKEN>"}}}
# COMPOSER_AUTH=

# On Laravel Cloud the Capell control plane provisions this app: it injects the
# build/deploy commands, COMPOSER_AUTH, admin details, and CAPELL_SITE_URL (read
# from the assigned domain after the first deploy), then capell:cloud-bootstrap
# completes the install. Nothing here is auto-applied. See README.md.
